# Database
# DATABASE_URL is what the running app/worker connects with -- this should
# be the app_user role created by db/migrate_rls_hardening.sql, NOT the
# table-owning role, or Row-Level Security tenant isolation silently does
# nothing (Postgres exempts table owners from their own RLS policies).
DATABASE_URL=postgres://app_user:changeme@localhost:5432/apex

# MIGRATION_DATABASE_URL is a separate, higher-privilege connection (the
# table-owning role) used only for running db/migrate_*.sql files --
# app_user does not have CREATE ROLE/CREATE FUNCTION/DDL privileges, by
# design, so migrations cannot run over DATABASE_URL once app_user is in
# place. Never point the app itself at this connection string.
MIGRATION_DATABASE_URL=postgres://postgres:changeme@localhost:5432/apex

# Magic Link / opt-out token signing (shared secret across actionTokens.js
# and prospectOptOutTokens.js)
ACTION_TOKEN_SECRET=replace-with-32-byte-random-hex

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WEBHOOK_URL=https://app.example.com
PLATFORM_NOTIFICATION_NUMBER=

# OpenAI
OPENAI_API_KEY=

# Postmark (prospect outreach email)
POSTMARK_SERVER_TOKEN=
OUTREACH_FROM_EMAIL=you@apexjunksolutions.com

# Admin auth gate for /api/prospects/* (server-to-server/script use —
# see lib/adminAuth.js's security note about why this is NOT sufficient
# for the browser dashboard).
ADMIN_API_TOKEN=replace-with-32-byte-random-hex
GOOGLE_PLACES_API_KEY=
HUNTER_API_KEY=
# Semicolon-separated "City, ST" list (semicolons between entries -- a
# comma already separates city from state within each one) -- drives TWO
# things off one shared source of truth: (1) which cities
# jobs/prospectDiscovery.js actually searches (was hardcoded to
# Sacramento only; now every city here gets searched), and (2)
# services/prospectScoring.js's geographic fit bonus.
# Leave unset to fall back to Sacramento, CA only / skip geo scoring.
TARGET_SERVICE_AREAS=Sacramento, CA;Stockton, CA;Modesto, CA
# Comma-separated search terms, one discovery pass per city per term --
# e.g. "junk removal,landscaping,moving company" to prospect multiple
# business types, not just junk removal. Leave unset to keep searching
# only "junk removal", same as before this was configurable.
TARGET_PROSPECT_QUERIES=junk removal
# Row in `tenants` that represents Apex's own outreach pipeline, so
# prospect-to-lead conversions don't mix into a paying customer's list.
PROSPECTING_HOUSE_TENANT_ID=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# One-time (non-recurring) Stripe Price IDs for credit packs, sold once a
# tenant uses up that feature's monthly free allowance -- see
# lib/usageCredits.js for the pack sizes these correspond to. Create these
# as one-time products/prices in Stripe, not recurring.
STRIPE_PHOTO_QUOTE_CREDITS_PRICE_ID=
STRIPE_PROSPECTING_CREDITS_PRICE_ID=

# App
APP_URL=https://app.example.com
PORT=3000
